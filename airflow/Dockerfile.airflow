FROM apache/airflow:3.3.2

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

USER airflow
COPY airflow/requirements-airflow.txt /tmp/requirements-airflow.txt

# BuildKit cache mount: pip's download cache persists across builds.
# First build: ~5-8 min.  Rebuild after code change (no requirements change): ~20 sec.
RUN --mount=type=cache,target=/home/airflow/.cache/pip,uid=50000,gid=0 \
    pip install -r /tmp/requirements-airflow.txt